{
  "schemaVersion": 1,
  "profiles": {
    "tooling": [
      "agent-tests"
    ],
    "web": [
      "agent-tests",
      "preview-tests",
      "server-tests",
      "desktop-tests",
      "build",
      "build-play"
    ],
    "python": [
      "python-lint",
      "python-format",
      "python-tests",
      "demo",
      "demo-verify"
    ],
    "security": [
      "secrets",
      "secret-history"
    ],
    "core": [
      "agent-tests",
      "preview-tests",
      "server-tests",
      "desktop-tests",
      "build",
      "build-play",
      "python-lint",
      "python-format",
      "python-tests",
      "demo",
      "demo-verify",
      "secrets"
    ],
    "browser": [
      "build",
      "security-browser",
      "reflections",
      "experience",
      "experience-commons",
      "shared",
      "ipic-screening"
    ],
    "full": [
      "dependency-audit",
      "agent-tests",
      "preview-tests",
      "server-redis-tests",
      "desktop-tests",
      "build",
      "build-play",
      "python-lint",
      "python-format",
      "python-tests",
      "demo",
      "demo-verify",
      "secrets",
      "secret-history",
      "security-browser",
      "reflections",
      "experience",
      "experience-commons",
      "shared",
      "ipic-screening"
    ],
    "preview": [
      "preview-tests"
    ],
    "server": [
      "server-tests"
    ],
    "desktop": [
      "desktop-tests"
    ],
    "build": [
      "build",
      "build-play"
    ],
    "desktop-package": [
      "desktop-tests",
      "desktop-package",
      "desktop-package-check"
    ],
    "screening": [
      "ipic-screening",
      "ipic-screening-soak"
    ]
  },
  "tasks": [
    {
      "id": "agent-tests",
      "command": [
        "pnpm",
        "run",
        "test:agent"
      ]
    },
    {
      "id": "preview-tests",
      "command": [
        "pnpm",
        "test"
      ]
    },
    {
      "id": "server-tests",
      "command": [
        "pnpm",
        "run",
        "test:server"
      ]
    },
    {
      "id": "server-redis-tests",
      "command": [
        "pnpm",
        "run",
        "test:server"
      ],
      "requiresEnv": [
        "REDIS_URL"
      ],
      "requiresTools": [
        "redis-server"
      ]
    },
    {
      "id": "desktop-tests",
      "command": [
        "pnpm",
        "run",
        "test:desktop"
      ]
    },
    {
      "id": "build",
      "command": [
        "pnpm",
        "run",
        "build"
      ]
    },
    {
      "id": "build-play",
      "command": [
        "pnpm",
        "run",
        "build:play"
      ]
    },
    {
      "id": "python-lint",
      "command": [
        "uv",
        "run",
        "--locked",
        "ruff",
        "check",
        "."
      ]
    },
    {
      "id": "python-format",
      "command": [
        "uv",
        "run",
        "--locked",
        "ruff",
        "format",
        "--check",
        "."
      ]
    },
    {
      "id": "python-tests",
      "command": [
        "uv",
        "run",
        "--locked",
        "pytest",
        "-q"
      ]
    },
    {
      "id": "demo",
      "command": [
        "uv",
        "run",
        "--locked",
        "river-oaks",
        "demo"
      ]
    },
    {
      "id": "demo-verify",
      "command": [
        "uv",
        "run",
        "--locked",
        "river-oaks",
        "verify",
        "--config",
        "data/generated/demo/config.json",
        "--raw",
        "data/generated/demo",
        "--world",
        "data/generated/demo/world.json",
        "--output",
        "data/generated/demo/report.json"
      ],
      "expectedExit": 2
    },
    {
      "id": "secrets",
      "command": [
        "uv",
        "run",
        "--locked",
        "python",
        "scripts/check_secrets.py",
        "--all"
      ],
      "requiresTools": [
        "gitleaks"
      ]
    },
    {
      "id": "secret-history",
      "command": [
        "gitleaks",
        "git",
        "--log-opts=--all",
        "--redact",
        "--no-banner",
        "--ignore-gitleaks-allow"
      ]
    },
    {
      "id": "reflections",
      "command": [
        "pnpm",
        "run",
        "test:reflections:webgl"
      ],
      "browser": true
    },
    {
      "id": "shared",
      "command": [
        "pnpm",
        "run",
        "test:shared"
      ],
      "browser": true,
      "timeoutMs": 1800000
    },
    {
      "id": "dependency-audit",
      "command": [
        "pnpm",
        "audit",
        "--audit-level=moderate"
      ]
    },
    {
      "id": "security-browser",
      "command": [
        "pnpm",
        "run",
        "test:security:e2e"
      ],
      "browser": true
    },
    {
      "id": "experience",
      "command": [
        "pnpm",
        "run",
        "test:experience",
        "player-lifecycle",
        "multiplayer-lifecycle",
        "contextual-first-visit",
        "store-intro",
        "photo-mode",
        "rail-navigation",
        "places-guide",
        "world-studio",
        "spatial-circulation",
        "spatial-streets",
        "office-desk",
        "office-visit",
        "office-computer-embed",
        "garden-campus-office",
        "garden-campus-traversal",
        "garden-campus-suite"
      ],
      "browser": true,
      "timeoutMs": 1200000
    },
    {
      "id": "experience-commons",
      "command": [
        "pnpm",
        "run",
        "test:experience",
        "east-garden-commons"
      ],
      "env": {
        "RIVER_OAKS_E2E_REPORT": "experience-commons.json"
      },
      "browser": true
    },
    {
      "id": "desktop-package",
      "command": [
        "pnpm",
        "run",
        "desktop:package"
      ]
    },
    {
      "id": "desktop-package-check",
      "command": [
        "pnpm",
        "run",
        "desktop:package:check"
      ]
    },
    {
      "id": "ipic-screening",
      "command": [
        "node",
        "preview/e2e/ipic-screening-runner.mjs"
      ],
      "browser": true,
      "timeoutMs": 600000
    },
    {
      "id": "ipic-screening-soak",
      "command": [
        "node",
        "preview/e2e/ipic-screening-soak-runner.mjs"
      ],
      "browser": true,
      "timeoutMs": 1800000
    }
  ]
}
