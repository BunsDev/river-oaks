{
  "name": "river-oaks-development-preview",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "prepare": "node scripts/enforce-pnpm.mjs && (git config core.hooksPath .githooks 2>/dev/null || true)",
    "dev": "vite --config preview/vite.config.js",
    "dev:landing": "vite --config landing-page/vite.config.js",
    "build": "vite build --config preview/vite.config.js && node scripts/build_landing_page.js",
    "test": "node --test preview/tests/*.test.js",
    "test:experience": "node preview/e2e/experience-runner.js",
    "test:shared": "node preview/e2e/shared-runner.js",
    "test:security:e2e": "node --test preview/e2e/email-access.test.js preview/e2e/debug-readout.test.js",
    "test:reflections:webgl": "node preview/e2e/reflections-webgl.js",
    "test:trees:webgl": "node preview/e2e/landscape-trees.js",
    "assets:trees": "node scripts/prepare_ez_tree.js",
    "server": "node --env-file-if-exists=.env server/start.js",
    "test:server": "node --test server/tests/*.test.js",
    "audit:multiplayer": "node server/performance-audit.js data/reports/multiplayer-performance-audit.json",
    "start": "node --env-file-if-exists=.env server/start.js",
    "server:redis": "node --env-file-if-exists=.env server/redis-start.js",
    "desktop:dev": "node --env-file-if-exists=.env desktop/dev.js",
    "desktop:start": "electron .",
    "desktop:package": "node desktop/package.js",
    "test:desktop": "node --test desktop/tests/*.test.js",
    "test:desktop:e2e": "node desktop/e2e.js",
    "audit:multiplayer:render": "node preview/audit/rendered-multiplayer.js",
    "agent:doctor": "node scripts/agent.mjs doctor",
    "agent:list": "node scripts/agent.mjs list",
    "verify": "node scripts/agent.mjs verify",
    "test:agent": "node --test scripts/tests/*.test.js",
    "test:desktop:photo": "node desktop/photo-e2e.js",
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "predev": "node scripts/enforce-pnpm.mjs",
    "predev:landing": "node scripts/enforce-pnpm.mjs",
    "prebuild": "node scripts/enforce-pnpm.mjs",
    "pretest": "node scripts/enforce-pnpm.mjs",
    "pretest:experience": "node scripts/enforce-pnpm.mjs",
    "pretest:shared": "node scripts/enforce-pnpm.mjs",
    "pretest:security:e2e": "node scripts/enforce-pnpm.mjs",
    "pretest:reflections:webgl": "node scripts/enforce-pnpm.mjs",
    "pretest:trees:webgl": "node scripts/enforce-pnpm.mjs",
    "preassets:trees": "node scripts/enforce-pnpm.mjs",
    "preserver": "node scripts/enforce-pnpm.mjs",
    "pretest:server": "node scripts/enforce-pnpm.mjs",
    "preaudit:multiplayer": "node scripts/enforce-pnpm.mjs",
    "prestart": "node scripts/enforce-pnpm.mjs",
    "preserver:redis": "node scripts/enforce-pnpm.mjs",
    "predesktop:dev": "node scripts/enforce-pnpm.mjs",
    "predesktop:start": "node scripts/enforce-pnpm.mjs",
    "predesktop:package": "node scripts/enforce-pnpm.mjs",
    "pretest:desktop": "node scripts/enforce-pnpm.mjs",
    "pretest:desktop:e2e": "node scripts/enforce-pnpm.mjs",
    "preaudit:multiplayer:render": "node scripts/enforce-pnpm.mjs",
    "preagent:doctor": "node scripts/enforce-pnpm.mjs",
    "preagent:list": "node scripts/enforce-pnpm.mjs",
    "preverify": "node scripts/enforce-pnpm.mjs",
    "pretest:agent": "node scripts/enforce-pnpm.mjs",
    "pretest:desktop:photo": "node scripts/enforce-pnpm.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "@workos-inc/node": "^11.0.0",
    "ioredis": "^6.0.0",
    "three": "0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@dgreenheck/ez-tree": "1.1.0",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "44.5.1",
    "playwright": "1.63.0",
    "vite": "8.3.2"
  },
  "main": "desktop/main.js",
  "packageManager": "pnpm@10.34.5"
}
