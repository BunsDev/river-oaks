# Load into the sidecar process environment; never place credentials in Unreal assets.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_AUTO_MODEL=jev-1.14.0
# Hosted only: paid Jev driving decisions per UTC day across all owners (default 6000, max 10000).
CHAUFFEUR_DAILY_LIMIT=
# Jev's voice is chosen in Settings (default Adam); enter the key there instead if preferred.
ELEVENLABS_API_KEY=

# Authentication and waitlist are required for both single and multiplayer.
# Configure a WorkOS development application for `npm run dev`. Leave
# PUBLIC_ORIGIN unset locally; set it on the production server.
# Private server settings; never prefix these with VITE_.
# PUBLIC_ORIGIN=https://typesafe.place
# Register http://127.0.0.1:5173/auth/callback in the development application.
# Browser and desktop clients require the shared town; there is no play-mode flag.
# Optional World map and Worlds directory in Places and Commands. Only true enables them.
# Restart dev or rebuild after changing this browser feature flag.
VITE_WORLD_MAP=false
# Optional Groups, event hosting, Build & decorate, and world publishing/editing.
# Only true enables these creation tools; restart dev or rebuild after changing it.
VITE_CREATION_TOOLS=false
# Character Studio release controls. Only 1 enables new server saves/publications
# and custom equips. Existing saved selections keep rendering when disabled.
RIVER_OAKS_CHARACTER_STUDIO=
# Optional server-only aggregate attempt counters; 1 enables, absent/other values disable.
RIVER_OAKS_CHARACTER_STUDIO_METRICS=
# Only true exposes the editor; rebuild after changing the browser flag.
VITE_CHARACTER_STUDIO=false
# Draft-only workplace test (#214); see docs/workplace-operations.md. The server
# flag is the kill switch: only 1 mounts /api/workplace/*. The browser flag only
# shows the panel and grants nothing; rebuild after changing it.
RIVER_OAKS_WORKPLACE=
VITE_WORKPLACE=false
# Vercel only: the secret Vercel Cron sends to /api/workplace-sweep. Leave unset
# elsewhere; long-lived servers sweep with their own timer.
CRON_SECRET=
# Jevica's office layout (server only; docs/offices.md). Unset or office-legacy-1 is the
# legacy room; office-penthouse-1 selects the penthouse. Personal workspaces stay legacy.
# Takes effect when the running processes are replaced (a new deployment on Vercel).
RIVER_OAKS_OFFICE_LAYOUT=
# IPIC screening hosts (server only; docs/screenings.md): comma-separated
# ipic:<userId>[@<ISO expiry>]. Unset means nobody can start or control a film.
# Takes effect when the running processes are replaced.
RIVER_OAKS_SCREENING_HOSTS=
# Shared voice between residents (docs/superpowers/plans/2026-10-05-spatial-voice.md).
# Only on mounts /api/voice/*, and only with all three LiveKit settings; the
# key and secret stay server-side. The browser receives short room tokens only.
RIVER_OAKS_VOICE=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional voice room namespace. Defaults to REDIS_NAMESPACE on the hosted
# gateway and river-oaks:local:v1 on the standalone town; give each developer
# machine its own so two laptops never share a room in one LiveKit project.
RIVER_OAKS_VOICE_NAMESPACE=
# Optional caps: voice joins per UTC day across all servers (default 5000, max
# 50000) and concurrent voice leases per namespace (default 256, max 1024).
VOICE_DAILY_JOINS=
VOICE_MAX_LEASES=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Signing secret for the optional WorkOS user.deleted webhook. Keep server-side.
WORKOS_WEBHOOK_SECRET=
# Generate a random secret of at least 32 characters; see docs/multiplayer.md.
WORKOS_COOKIE_PASSWORD=
# Email sign-in codes WorkOS may send per UTC day across all servers (default 2000,
# max 100000). Past it, email sign-in pauses until tomorrow; GitHub sign-in still works.
EMAIL_SIGNIN_DAILY_LIMIT=
# Each client address's share of those sends per UTC day (default 10, max 1000).
EMAIL_SIGNIN_DAILY_PER_ADDRESS=
# Optional Cloudflare Turnstile on email sign-in. The secret stays server-side;
# the site key is public and built into the sign-in page. Set both or neither.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
# Optional: a GitHub token with no scopes for looking up residents' public
# GitHub usernames. Without it, lookups are anonymous (60 an hour per address).
GITHUB_TOKEN=
HOST=127.0.0.1
PORT=8787
MODERATION_FILE=.runtime/moderation.json
# Comma-separated WorkOS user IDs authorized to moderate the town.
MODERATOR_USER_IDS=
# Comma-separated WorkOS user IDs authorized to approve waitlist requests.
WAITLIST_ADMIN_USER_IDS=
# Standalone server only. Keep this path on a private persistent volume.
WAITLIST_FILE=.runtime/waitlist.json
# Exact IPs of trusted reverse proxies; empty means ignore forwarded IP headers.
TRUSTED_PROXY_IPS=

# Vercel Marketplace supplies REDIS_URL to Production. Local Redis API needs both.
REDIS_URL=
# Isolate development/preview from the production town.
REDIS_NAMESPACE=river-oaks:development:v1
# Production defaults to river-oaks:production:access:v1. Preview must use
# a distinct namespace; changing it discards access decisions.
# WAITLIST_NAMESPACE=river-oaks:development:access:v1

# Production landing page returns sign-ins to the game. Local default is /.
# AUTH_RETURN_PATH=/play
