# Load into the sidecar process environment; never place credentials in Unreal assets.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_AUTO_MODEL=jev-1.13.0
# Jev's voice is chosen in Settings (default Adam); enter the key there instead if preferred.
ELEVENLABS_API_KEY=

# Shared town (multiplayer). `npm run dev` runs it with local development
# identities and needs none of the settings below. Leave PUBLIC_ORIGIN unset
# locally; set it to https://sim.jev.works only on the production server.
# Private server settings; never prefix these with VITE_.
# PUBLIC_ORIGIN=https://sim.jev.works
# Opt in to WorkOS during development (register http://127.0.0.1:5173/auth/callback).
# RIVER_OAKS_DEV_AUTH=workos
# The live site stays single player unless the build sets VITE_MULTIPLAYER=required.
# VITE_MULTIPLAYER=off|auto|required
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate a random secret of at least 32 characters; see docs/multiplayer.md.
WORKOS_COOKIE_PASSWORD=
HOST=127.0.0.1
PORT=8787
MODERATION_FILE=.runtime/moderation.json
# Comma-separated WorkOS user IDs authorized to moderate the town.
MODERATOR_USER_IDS=
# Exact IPs of trusted reverse proxies; empty means ignore forwarded IP headers.
TRUSTED_PROXY_IPS=

# Vercel Marketplace supplies REDIS_URL to Production. Local Redis API needs both.
REDIS_URL=
# Isolate development/preview from the production town.
REDIS_NAMESPACE=river-oaks:development:v1
