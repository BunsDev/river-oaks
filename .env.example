# Load into the sidecar process environment; never place credentials in Unreal assets.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_AUTO_MODEL=jev-1.13.0
# Jev's voice is chosen in Settings (default Adam); enter the key there instead if preferred.
ELEVENLABS_API_KEY=

# Authentication and waitlist are required for both single and multiplayer.
# Configure a WorkOS development application for `npm run dev`. Leave
# PUBLIC_ORIGIN unset locally; set it on the production server.
# Private server settings; never prefix these with VITE_.
# PUBLIC_ORIGIN=https://sim.jev.works
# Register http://127.0.0.1:5173/auth/callback in the development application.
# Players choose single player or multiplayer; single player is the initial choice.
# VITE_MULTIPLAYER=choice|off|auto|required
# Optional World map and Worlds directory in Places and Commands. Only true enables them.
# Restart dev or rebuild after changing this browser feature flag.
VITE_WORLD_MAP=false
# Optional Groups, event hosting, Build & decorate, and world publishing/editing.
# Only true enables these creation tools; restart dev or rebuild after changing it.
VITE_CREATION_TOOLS=false
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate a random secret of at least 32 characters; see docs/multiplayer.md.
WORKOS_COOKIE_PASSWORD=
# Optional: a GitHub token with no scopes for looking up residents' public
# GitHub usernames. Without it, lookups are anonymous (60 an hour per address).
GITHUB_TOKEN=
HOST=127.0.0.1
PORT=8787
MODERATION_FILE=.runtime/moderation.json
# Comma-separated WorkOS user IDs authorized to moderate the town.
MODERATOR_USER_IDS=
# Comma-separated WorkOS user IDs authorized to approve waitlist requests.
WAITLIST_ADMIN_USER_IDS=
# Standalone server only. Keep this path on a private persistent volume.
WAITLIST_FILE=.runtime/waitlist.json
# Exact IPs of trusted reverse proxies; empty means ignore forwarded IP headers.
TRUSTED_PROXY_IPS=

# Vercel Marketplace supplies REDIS_URL to Production. Local Redis API needs both.
REDIS_URL=
# Isolate development/preview from the production town.
REDIS_NAMESPACE=river-oaks:development:v1
# Production defaults to river-oaks:production:access:v1. Preview must use
# a distinct namespace; changing it discards access decisions.
# WAITLIST_NAMESPACE=river-oaks:development:access:v1
