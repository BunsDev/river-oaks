{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "corepack pnpm run build",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "outputDirectory": "dist/preview",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' data: blob: https://*.livekit.cloud wss://*.livekit.cloud; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "Permissions-Policy", "value": "microphone=(self), camera=(), geolocation=(), display-capture=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/(.*\\.(?:glb|hdr|jpg|jpeg|png|webp|ktx2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(ipic/screening/[^/]+\\.(?:mp4|webm|vtt))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/((?!.*\\.(?:glb|hdr|jpg|jpeg|png|webp|ktx2)$)(?!ipic/screening/[^/]+\\.(?:mp4|webm|vtt)$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/server.js": {
      "maxDuration": 300,
      "includeFiles": "{preview/public/data/district*.json,src/river_oaks/chauffeur-policy.json}"
    }
  },
  "regions": [
    "iad1"
  ],
  "crons": [
    { "path": "/api/workplace-sweep", "schedule": "* * * * *" },
    { "path": "/api/voice-sweep", "schedule": "* * * * *" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sim.jev.works"
        }
      ],
      "destination": "https://typesafe.place/play",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sim.jev.works"
        }
      ],
      "destination": "https://typesafe.place/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/workos/events", "destination": "/api/server?_river_path=/api/workos/events" },
    { "source": "/api/chauffeur", "destination": "/api/server?_river_path=/api/chauffeur" },
    {
      "source": "/auth/login",
      "destination": "/api/server?_river_path=/auth/login"
    },
    {
      "source": "/auth/email/start",
      "destination": "/api/server?_river_path=/auth/email/start"
    },
    {
      "source": "/auth/email/verify",
      "destination": "/api/server?_river_path=/auth/email/verify"
    },
    {
